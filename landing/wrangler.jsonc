{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-p2p-voice-call",
  "main": "worker.ts",
  "compatibility_date": "2026-10-07",
  "build": { "command": "npm ci --no-engine-strict && npm run build" },
  "vars": { "PUBLIC_API_ORIGIN": "https://telegram-p2p-voice-call-production-812e.up.railway.app" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
