{
  "name": "landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "check": "node scripts/check-build.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:check": "wrangler deploy --dry-run",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
