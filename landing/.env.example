VITE_BOT_USERNAME=PairTalkBot
# Public aggregate endpoint; no admin credentials belong in frontend environment variables.
VITE_PUBLIC_STATS_URL=/api/public/stats
# Public pricing catalog shared with the client, admin and Telegram bot.
VITE_PUBLIC_PRICING_URL=/api/public/plans
# Backend origin used by the local public API proxy. Production: PUBLIC_API_ORIGIN in wrangler.jsonc.
# Set this to the reachable backend service; do not use the public site's own origin.
PUBLIC_API_ORIGIN=https://api.pairtalk.online
# Optional dated pricing snapshot for pre-rendered /pricing HTML.
# PUBLIC_PRICING_BUILD_URL=https://pairtalk.online/api/public/plans
# Optional build-time endpoint for dated statistics in pre-rendered HTML.
# Set this in the build environment, not as a VITE_ variable.
# PUBLIC_STATS_BUILD_URL=https://pairtalk.online/api/public/stats
