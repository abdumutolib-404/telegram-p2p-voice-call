# LOCAL DOCKER COMPOSE ONLY. This is NOT the production backend template.
# Production on Fly.io/Railway uses server/.env.example in Variables/Secrets.
# Node does not automatically load this root file.

# Choose your local PostgreSQL password; required even when starting only db.
POSTGRES_PASSWORD=

# Required only when starting Compose's combined app service.
# Telegram BotFather token and numeric administrator user IDs.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
# Choose these app secrets. Compose calls the password ADMIN_MASTER_PASSWORD.
ADMIN_MASTER_PASSWORD=
JWT_SECRET=

# Copy LiveKit Cloud's Project URL exactly (wss://...), API Key and API Secret.
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local frontend URLs served by the combined app container.
MINI_APP_URL=http://localhost:3001/client
ADMIN_PANEL_URL=http://localhost:3001/admin
