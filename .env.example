# ==============================================================================
# PAIRTALK — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholders with real deployment values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Port for the backend API and WebSocket signaling server
PORT=3001

# Application environment ('development', 'test', or 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOTS CONFIGURATION
# ------------------------------------------------------------------------------
# Main Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# (Optional) Secondary Outbound Bot Token for admin payment receipt notifications
PAYMENTS_BOT_TOKEN=YOUR_PAYMENTS_BOT_TOKEN_HERE

# ------------------------------------------------------------------------------
# 3. ADMIN SECURITY & AUTHENTICATION (STEALTH 2FA)
# ------------------------------------------------------------------------------
# Comma-separated numeric Telegram IDs of authorized administrators
ADMIN_TELEGRAM_IDS=123456789,987654321

# Master Password for Web Admin Panel access (MUST be changed in production!)
MASTER_PASSWORD=CHANGE_ME_TO_STRONG_MASTER_PASSWORD

# Secret key for signing admin JWT session tokens (MUST be changed in production!)
JWT_SECRET=CHANGE_ME_TO_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET

# ------------------------------------------------------------------------------
# 4. DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL Database connection URL (e.g. Railway, Supabase, AWS RDS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pairtalk

# Redis connection URL for matchmaking queues, sliding rate limits, and 2FA OTPs
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. LIVEKIT SFU WEBRTC & CLOUD AUDIO EGRESS
# ------------------------------------------------------------------------------
# LiveKit Cloud or self-hosted server WebSocket/HTTP URL
LIVEKIT_HOST=https://YOUR_PROJECT.livekit.cloud

# LiveKit API Key
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY

# LiveKit API Secret
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ------------------------------------------------------------------------------
# 6. CLIENT & ADMIN PANEL PUBLIC URLS (CORS & WEBHOOKS)
# ------------------------------------------------------------------------------
# Public URL where the Telegram Mini App (React client) is hosted
MINI_APP_URL=https://your-domain.com

# Public URL where the Web Admin Panel is hosted
ADMIN_PANEL_URL=https://your-domain.com/admin

# Comma-separated allowed CORS origins for external API access
ALLOWED_ORIGINS=https://your-domain.com,https://web.telegram.org

# Public URLs for Legal Policies (defaults to Mini App /privacy and /guidelines)
PRIVACY_POLICY_URL=https://your-domain.com/privacy
COMMUNITY_GUIDELINES_URL=https://your-domain.com/guidelines

# ------------------------------------------------------------------------------
# 7. RECORDINGS & AWS S3 CLOUD STORAGE
# ------------------------------------------------------------------------------
# Local scratch directory for temporary recording egress processing
RECORDINGS_DIR=./recordings

# AWS S3 IAM Access Key with PutObject, GetObject, ListBucket permissions
S3_KEY=YOUR_AWS_ACCESS_KEY_ID

# AWS S3 IAM Secret Access Key
S3_SECRET=YOUR_AWS_SECRET_ACCESS_KEY

# AWS S3 Bucket Name for storing finalized .mp3 audio recordings
S3_BUCKET=pairtalk-recordings-bucket

# AWS S3 Region where the bucket is created (e.g. eu-north-1, us-east-1)
S3_REGION=eu-north-1

# (Optional) Custom S3 endpoint URL (leave empty for standard AWS S3; use for MinIO)
S3_ENDPOINT=

# Set to 'true' for path-style S3 buckets (e.g. MinIO); 'false' for AWS S3
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 8. MANUAL UZS CARD PAYMENT REQUISITES
# ------------------------------------------------------------------------------
# Support Telegram username displayed to users for payment inquiries
MANUAL_PAYMENT_ADMIN_USERNAME=PairTalkSupport

# Telegram Chat ID to receive admin notifications for submitted payment receipts
MANUAL_PAYMENT_ADMIN_CHAT_ID=123456789

# Payment instructions shown to users when selecting Card payment
MANUAL_PAYMENT_INSTRUCTIONS="1. Transfer exact amount to the card.\n2. Save receipt screenshot or PDF.\n3. Send receipt here in bot for verification."

# Cardholder name or organization displayed on payment card prompt
MANUAL_PAYMENT_CARD_HOLDER="PairTalk Official (Humo / Uzcard)"
