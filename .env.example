# ==============================================================================
# PairTalk Environment Variables Template (.env.example)
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Core Ports & Runtime
PORT=3001
NODE_URL=http://127.0.0.1:3000
NODE_ENV=development

# Persistent Storage
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pairtalk?sslmode=disable"
REDIS_URL="redis://localhost:6379"

# Telegram Bot
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Optional secondary bot for payments
# PAYMENTS_BOT_TOKEN="987654321:AAFakePaymentsBotToken"

# Administrative & Security Access
MASTER_PASSWORD="LocalDevAdminPassword123!"
JWT_SECRET="local_development_cryptographically_secure_jwt_secret_32b"
ADMIN_TELEGRAM_IDS="123456789"

# Public Application URLs (for Telegram WebApp deep links & CORS)
MINI_APP_URL="http://localhost:5173"
ADMIN_PANEL_URL="http://localhost:5174"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,https://web.telegram.org"

# LiveKit SFU (WebRTC Audio)
# Either LIVEKIT_HOST or LIVEKIT_URL is accepted
LIVEKIT_HOST="https://dev-livekit.example.com"
# LIVEKIT_URL="https://dev-livekit.example.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Object Storage (AWS S3 / Cloudflare R2 / MinIO) - Optional in local dev
S3_KEY=""
S3_SECRET=""
S3_BUCKET="pairtalk-recordings"
S3_REGION="eu-north-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=false
RECORDINGS_DIR="recordings"

# Manual Payment Support & Dispatches
MANUAL_PAYMENT_ADMIN_USERNAME="PairTalkSupport"
MANUAL_PAYMENT_ADMIN_CHAT_ID="123456789"
MANUAL_PAYMENT_CARD_HOLDER="PairTalk Edu LLC"
MANUAL_PAYMENT_INSTRUCTIONS="Please transfer the exact amount and upload your receipt screenshot."

# Legal & Compliance
PRIVACY_POLICY_URL="https://pairtalk.online/privacy"
COMMUNITY_GUIDELINES_URL="https://pairtalk.online/community-guidelines"

# AI Topic Curation (Optional - falls back to heuristic taxonomy)
# GEMINI_API_KEY="AIzaSy..."
# GEMINI_MODEL="gemini-2.0-flash"
