# Copy to infra/vm-staging/.env on the VM. Never commit the private copy.
# Every REPLACE_* value is a placeholder, not a usable credential.

PAIRTALK_IMAGE=ghcr.io/REPLACE_ORG/pairtalk@sha256:REPLACE_WITH_VERIFIED_DIGEST

POSTGRES_USER=pairtalk_staging
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=pairtalk_staging

# Public API origin served by Caddy. The Cloudflare Pages builds must use this
# value as VITE_SERVER_URL when they are built for staging.
API_HOST=api-staging.example.com
ACME_EMAIL=ops@example.com

# Space-separated current Cloudflare origin CIDRs. Refresh from Cloudflare's
# published list before each new VM; do not use private_ranges here.
CADDY_TRUSTED_PROXIES=REPLACE_WITH_CURRENT_CLOUDFLARE_CIDRS
# Caddy reaches the Go gateway from this fixed Compose subnet.
TRUSTED_PROXY_CIDRS=172.30.0.0/24,127.0.0.0/8,::1/128

NODE_ENV=production
BOT_TOKEN=REPLACE_WITH_FRESH_STAGING_BOT_TOKEN
DISABLE_BOT_POLLING=true
DISABLE_BACKGROUND_CRAWLER=true
MASTER_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
ADMIN_TELEGRAM_IDS=REPLACE_WITH_STAGING_ADMIN_TELEGRAM_ID

# These are external Cloudflare-hosted frontend origins, not VM routes.
MINI_APP_URL=https://app-staging.example.com
ADMIN_PANEL_URL=https://admin-staging.example.com
ALLOWED_ORIGINS=https://app-staging.example.com,https://admin-staging.example.com,https://pairtalk.online,https://web.telegram.org,https://webk.telegram.org,https://webz.telegram.org

# Private LiveKit project. A LiveKit Cloud host still needs private R2/S3
# credentials for durable egress recordings.
LIVEKIT_HOST=REPLACE_WITH_PRIVATE_LIVEKIT_HOST
LIVEKIT_API_KEY=REPLACE_WITH_STAGING_LIVEKIT_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_STAGING_LIVEKIT_SECRET

# Cloudflare R2's S3-compatible endpoint and private bucket.
S3_KEY=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET=REPLACE_WITH_R2_SECRET_KEY
S3_BUCKET=REPLACE_WITH_PRIVATE_R2_BUCKET
S3_REGION=auto
S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
RECORDINGS_DIR=/app/server/recordings

PRIVACY_POLICY_URL=https://pairtalk.online/privacy
COMMUNITY_GUIDELINES_URL=https://pairtalk.online/community-guidelines
