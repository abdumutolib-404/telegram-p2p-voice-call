# Cloudflare Worker: root directory client; build npm run build; deploy npm run deploy (assets from dist).
# Public HTTPS backend origin assigned by Fly.io OR Railway. No secrets here.
VITE_SERVER_URL=
# Separate Worker serves this application at the domain root.
VITE_BASE_PATH=/
# Redirect external visits to the public landing site. Use http://127.0.0.1:4173 for local preview.
VITE_PUBLIC_SITE_URL=https://pairtalk.online
# Public bot username from BotFather, without @. Used for registration and payment links.
VITE_BOT_USERNAME=PairTalkBot
