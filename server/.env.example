# PairTalk backend — Cloudflare R2 + Fly.io OR Railway.
# Copy to server/.env for local use. In production, set these in the host's
# Variables/Secrets settings. Blank provider fields must be filled before launch.
# Provider values are copied exactly; application variable names below are fixed.
# See docs/ENVIRONMENT_AND_DEPLOYMENT.md for the provider-to-variable mapping.

# Runtime. Railway supplies PORT automatically; Fly must use internal_port=3001.
NODE_ENV=production
PORT=3001
# Keep the internal Node API private inside the combined Docker container.
HOST=127.0.0.1

# Telegram: BotFather's HTTP API token, without changing it.
BOT_TOKEN=
# Optional public BotFather username without @; successful bot startup verifies it.
# Used for public checkout links before the bot has initialized.
BOT_USERNAME=
# Optional separate payment bot. Leave blank to use the main bot.
PAYMENTS_BOT_TOKEN=

# PostgreSQL/Redis: copy the provider's connection URI, including its protocol.
# DATABASE_URL is shared with Go: do not add Prisma-only query parameters.
DATABASE_URL=
REDIS_URL=

# LiveKit Cloud: Project URL (wss://...), API Key, and API Secret.
# If LiveKit labels its export LIVEKIT_URL, copy that VALUE to LIVEKIT_HOST.
# Do not convert wss:// to https:// or prepend another protocol.
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare R2: S3 API credentials, NOT a general Cloudflare API token.
# S3_KEY = Access Key ID; S3_SECRET = Secret Access Key.
# S3_BUCKET = exact private bucket name; S3_ENDPOINT = bucket's S3 API endpoint.
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_ENDPOINT=
# R2 protocol settings (these are application settings, not account secrets).
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Temporary local working directory, not durable production storage.
RECORDINGS_DIR=./recordings

# Cloudflare Pages: complete public HTTPS URLs, after domains are assigned.
MINI_APP_URL=
ADMIN_PANEL_URL=
# Comma-separated browser origins only, without paths or trailing slashes.
ALLOWED_ORIGINS=
PRIVACY_POLICY_URL=
COMMUNITY_GUIDELINES_URL=

# PairTalk administrator settings: these are NOT supplied by a cloud provider.
# ADMIN_TELEGRAM_IDS = your admins' numeric Telegram user IDs, comma-separated.
# Choose a strong MASTER_PASSWORD and a random JWT_SECRET (at least 32 bytes).
ADMIN_TELEGRAM_IDS=
MASTER_PASSWORD=
JWT_SECRET=

# Trust only actual immediate proxy peer CIDRs for the chosen backend host.
# Loopback default below does not automatically trust Fly/Railway ingress.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
DISABLE_BOT_POLLING=false
DISABLE_BACKGROUND_CRAWLER=false

# Optional regional payment details. Leave unused fields blank.
MANUAL_PAYMENT_ADMIN_USERNAME=
MANUAL_PAYMENT_ADMIN_CHAT_ID=
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYMENT_CARD_HOLDER=

# Optional question curation integration.
GEMINI_API_KEY=
GEMINI_MODEL=
