datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model NotificationJob {
  id            String   @id @default(uuid())
  namespace     String
  dedupeKey     String?
  telegramId    String
  text          String
  optionsJson   String?
  status        String   @default("QUEUED")
  urgent        Boolean  @default(false)
  retries       Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leasedAt      DateTime?
  failure       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([namespace, status, nextAttemptAt])
  @@unique([namespace, dedupeKey])
}

// Written in the same transaction as completion; Redis events are only wake-up hints.
model PostCallJob {
  callId        String      @id
  call          CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  reason        String?
  deniedUserId  String?
  retentionA    Int         @default(0)
  retentionB    Int         @default(0)
  status        String      @default("QUEUED")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  leaseUntil    DateTime?
  owner         String?
  failure       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
}

model User {
  id                  String                 @id @default(uuid())
  telegramId          BigInt                 @unique
  alias               String                 @unique
  subFC               Float                  @default(6.0)
  subLR               Float                  @default(6.0)
  subGRA              Float                  @default(6.0)
  subP                Float                  @default(6.0)
  band                Float                  @default(6.0)
  plan                String                 @default("FREE") // "FREE", "PLUS", "PRO", "BOSS"
  subscriptionStatus  String                 @default("NONE") // "NONE", "ACTIVE", "PENDING_UPGRADE", "EXPIRED", "CANCELLED", "REFUNDED"
  subscriptionExpiresAt DateTime?
  customPlanName      String?
  maxDuration         Int                    @default(15) // max call duration in minutes
  dailyLimit          Int                    @default(3)
  dailyCallsUsed      Int                    @default(0)
  retentionOverride   Int?                   // custom recording retention in days
  recordingLimitOverride Int?               // custom recording limit
  referredByUserId    String?                // User ID of inviter
  referredAt          DateTime?              // Timestamp of referral
  lastCallDate        String?                // YYYY-MM-DD
  warningCount        Int                    @default(0)
  isBanned            Boolean                @default(false)
  bannedUntil         DateTime?
  isPermanentlyBanned Boolean                @default(false)
  dnd                 Boolean                @default(false)
  onboarded           Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  referredBy          User?                  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals           User[]                 @relation("UserReferrals")
  referralRewards     ReferralReward[]       @relation("UserRewards")
  friendRewards       ReferralReward[]       @relation("ReferredFriendRewards")
  callsAsA            CallSession[]          @relation("UserACalls")
  callsAsB            CallSession[]          @relation("UserBCalls")
  ratingsGiven        CallRating[]           @relation("RatingsGiven")
  ratingsReceived     CallRating[]           @relation("RatingsReceived")
  appeals             UnblockAppeal[]
  starsTransactions   StarsTransaction[]
  manualPayments      ManualPaymentRequest[]
  favorites           FavoritePartner[]      @relation("UserFavorites")
  favoritedBy         FavoritePartner[]      @relation("PartnerFavorites")

  @@index([subscriptionExpiresAt])
  @@index([isBanned])
}

model CallSession {
  id                 String       @id @default(uuid())
  roomName           String       @unique
  userAId            String
  userBId            String
  userA              User         @relation("UserACalls", fields: [userAId], references: [id])
  userB              User         @relation("UserBCalls", fields: [userBId], references: [id])
  status             String       @default("ACTIVE") // "ACTIVE", "COMPLETED", "CANCELLED"
  egressId           String?
  recordingUrl       String?
  recordingExpiresAt DateTime?
  recordedByUserId   String?
  activeRecorderIds  String?
  readyParticipantIds String[]    @default([])
  mediaAuthorizedAt DateTime?
  recordingKeys     String[]     @default([])
  duration           Int          @default(0) // call duration in seconds
  createdAt          DateTime     @default(now())
  endedAt            DateTime?

  ratings            CallRating[]
  postCallJob        PostCallJob?

  @@index([userAId, status, createdAt])
  @@index([userBId, status, createdAt])
  @@index([egressId])
  @@index([status])
  @@index([recordingExpiresAt])
  @@index([status, recordingUrl, createdAt])
}

model CallRating {
  id         String      @id @default(uuid())
  callId     String
  raterId    String
  ratedId    String
  stars      Int         // 1-5
  feedback   String?     // feedback or report reason
  reported   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  call       CallSession @relation(fields: [callId], references: [id])
  rater      User        @relation("RatingsGiven", fields: [raterId], references: [id])
  rated      User        @relation("RatingsReceived", fields: [ratedId], references: [id])

  @@index([ratedId])
  @@index([callId])
}

model UnblockAppeal {
  id          String    @id @default(uuid())
  userId      String
  telegramId  BigInt
  alias       String
  banReason   String
  appealText  String
  status      String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?

  user        User      @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
}

model StarsTransaction {
  id                String    @id @default(uuid())
  orderNumber       String?   @unique
  userId            String
  telegramPaymentId String    @unique
  starsAmount       Int
  planTier          String    // "PLUS", "PRO", "BOSS"
  entitlementApplied Boolean @default(true)
  status            String    @default("PAID") // "PAID", "REFUND_PENDING", "REFUNDED"
  refundReason      String?
  refundedAt        DateTime?
  refundRequestedAt DateTime?
  refundAdminId     String?
  refundFailure     String?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([orderNumber])
}

model ManualPaymentRequest {
  id               String    @id @default(uuid())
  orderNumber      String    @unique @default("A0")
  userId           String
  telegramId       BigInt
  alias            String
  plan             String    // "PLUS", "PRO", "BOSS"
  uzsAmount        Int
  paymentProof     String?
  status           String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "REFUND_PENDING", "REFUNDED"
  refundCardNumber String?
  refundProof      String?
  refundReason     String?
  adminNote        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([orderNumber])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // "MANUAL_PAYMENT_APPROVAL", "MANUAL_PAYMENT_REJECTION", "STARS_REFUND_REVOKE", "PLAN_UPDATE", "USER_MODERATION", "SET_RETENTION"
  targetId    String?
  adminId     String
  beforeState String?
  afterState  String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetId])
}

model FavoritePartner {
  id        String   @id @default(uuid())
  userId    String
  partnerId String
  createdAt DateTime @default(now())

  user      User     @relation("UserFavorites", fields: [userId], references: [id])
  partner   User     @relation("PartnerFavorites", fields: [partnerId], references: [id])

  @@unique([userId, partnerId])
}

model ReferralReward {
  id               String       @id @default(uuid())
  userId           String       // Inviter user ID
  referredUserId   String       // Friend user ID
  qualifyingCallId String?      // Call ID that triggered reward
  status           String       @default("AVAILABLE") // "AVAILABLE", "USED"
  expiresAt        DateTime?    // Optional legacy timestamp
  usedAt           DateTime?
  createdAt        DateTime     @default(now())

  user             User         @relation("UserRewards", fields: [userId], references: [id])
  referredFriend   User         @relation("ReferredFriendRewards", fields: [referredUserId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
}

model Contest {
  id          String    @id @default(uuid())
  title       String    @default("IELTS Speaking Referral Championship")
  description String    @default("Invite your friends to practice IELTS speaking! Top referrers win exclusive custom plans and prizes.")
  prizes      String    @default("🥇 1st: 60-Day VIP Plan\n🥈 2nd: 30-Day BOSS Plan\n🥉 3rd: 14-Day PRO Plan")
  isActive    Boolean   @default(false)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum IeltsPart {
  PART_1
  PART_2
  PART_3
}

model IeltsTopic {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  description    String?
  relevance      Int             @default(5) // 1-10 priority/frequency
  sourceMetadata String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  questions      IeltsQuestion[]

  @@index([slug, isActive])
  @@index([relevance])
}

model IeltsQuestion {
  id             String     @id @default(uuid())
  topicId        String
  part           IeltsPart
  questionText   String
  cueCardBullets String?    // For Part 2 cue cards (JSON array of bullet points)
  questionType   String     @default("GENERAL") // "GENERAL", "CUE_CARD", "DISCUSSION", "FOLLOW_UP"
  source         String     @default("OFFICIAL_RECALL")
  sourceUrl      String?
  sourceHash     String     @unique // Deterministic SHA-256 fingerprint of normalized text
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  topic          IeltsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([part, isActive])
  @@index([topicId, part, isActive])
}

model CrawlerSyncLog {
  id                  String    @id @default(uuid())
  status              String    // "SUCCESS", "FAILED", "RUNNING"
  sourcesProcessed    Int       @default(0)
  questionsDiscovered Int       @default(0)
  questionsAccepted   Int       @default(0)
  duplicatesSkipped   Int       @default(0)
  topicsCreated       Int       @default(0)
  errors              String?
  durationMs          Int       @default(0)
  startedAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([startedAt])
}
