{
  "name": "telegram-p2p-voice-server",
  "version": "1.0.0",
  "description": "Telegram Bot & Signaling Server for P2P WebRTC Voice Calls",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc && node scripts/copyAssets.cjs",
    "start": "node dist/index.js",
    "db:deploy": "prisma migrate deploy",
    "dev": "ts-node src/index.ts",
    "test": "vitest run --testTimeout 15000",
    "export:questions": "ts-node scripts/exportQuestions.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "deploy:check": "tsc --noEmit --target ES2022 --module Node16 --moduleResolution Node16 --esModuleInterop --skipLibCheck railway.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^5.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.26.0",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.1.2",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.5",
    "zod": "^4.5.4",
    "prisma": "^5.12.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "railway": "3.13.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "node-cron": {
      "uuid": "11.1.1"
    }
  }
}
